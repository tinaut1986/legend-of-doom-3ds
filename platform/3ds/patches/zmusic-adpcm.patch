new file mode 100644
index 0000000..734ac1e
--- /dev/null
+++ b/source/decoder/adpcm_decoder.h
@@ -0,0 +1,49 @@
+#ifndef ADPCM_DECODER_H
+#define ADPCM_DECODER_H
+
+#include "zmusic/sounddecoder.h"
+#include <cstdint>
+#include <vector>
+
+// IMA ADPCM in a WAV file (format tag 0x11), mono or stereo. Decoding is a table lookup and a few
+// adds a sample, against an MP3 frame's transforms: the Old 3DS's music stream has 30% of one
+// 268 MHz core, and minimp3 could not keep up even at 22 kHz.
+struct ImaAdpcmDecoder : public SoundDecoder
+{
+	virtual void getInfo(int* samplerate, ChannelConfig* chans, SampleType* type) override;
+
+	virtual size_t read(char* buffer, size_t bytes) override;
+	virtual bool seek(size_t offset, bool ms, bool mayrestart) override;
+	virtual size_t getSampleOffset() override;
+	virtual size_t getSampleLength() override;
+
+	ImaAdpcmDecoder() = default;
+	ImaAdpcmDecoder(const ImaAdpcmDecoder& rhs) = delete;
+	ImaAdpcmDecoder& operator=(const ImaAdpcmDecoder& rhs) = delete;
+
+	virtual ~ImaAdpcmDecoder();
+
+protected:
+	virtual bool open(MusicIO::FileInterface* reader) override;
+
+private:
+	bool decodeBlock(uint32_t index);
+
+	MusicIO::FileInterface* Reader = nullptr;
+	long DataStart = 0;
+	int SampleRate = 0;
+	int Channels = 0;
+	uint32_t BlockAlign = 0;
+	uint32_t FramesPerBlock = 0;
+	uint32_t Blocks = 0;
+	uint64_t TotalFrames = 0;
+
+	std::vector<uint8_t> Block;
+	std::vector<int16_t> Pcm;       // the current block, decoded, interleaved
+	uint32_t BlockIndex = 0;        // the block in Pcm
+	uint32_t PcmFrames = 0;         // frames in Pcm
+	uint32_t PcmPos = 0;            // next frame of Pcm to hand out
+	uint64_t FramePos = 0;          // frames handed out since the start
+};
+
+#endif /* ADPCM_DECODER_H */
