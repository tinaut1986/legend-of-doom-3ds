index 0000000..5b11284
--- /dev/null
+++ b/actors/LegendPauseMenu.zs
@@ -0,0 +1,201 @@
+class ListMenuItemResume : ListMenuItemTextItem
+{
+    override bool Activate()
+    {
+        let current = Menu.GetCurrentMenu();
+        if (current != null)
+            current.Close();
+
+        return true;
+    }
+}
+
+class LegendSplitOptionMenu : OptionMenu
+{
+    override bool UseSplitOptionLayout() { return true; }
+    override bool UseCompactSplitSliders() { return true; }
+    override int GetSplitLabelLeft() { return screen.GetWidth() * 24 / 100; }
+    override int GetSplitValueLeft() { return screen.GetWidth() * 55 / 100; }
+    override int GetSplitValueRight() { return screen.GetWidth() * 76 / 100; }
+
+    // OPTIONS is one screen with tabs (PLAN U1): L and R move between these
+    // menus, which the 3DS draws on the touch screen with the tabs on top. The
+    // last one (DEBUG) only in debug builds: lod3ds_debug_tools, set by the engine.
+    static int TabCount()
+    {
+        let debug = CVar.FindCVar('lod3ds_debug_tools');
+        return debug != null && debug.GetBool() ? 4 : 3;
+    }
+
+    int TabIndex()
+    {
+        Name n = mDesc.mMenuName;
+        if (n == 'LegendDisplayOptions') return 0;
+        if (n == 'LegendSoundOptions') return 1;
+        if (n == 'LegendControllerOptions') return 2;
+        if (n == 'LegendDeveloperOptions') return 3;
+        return -1;
+    }
+
+    static Name TabMenu(int tab)
+    {
+        switch (tab)
+        {
+        case 0: return 'LegendDisplayOptions';
+        case 1: return 'LegendSoundOptions';
+        case 2: return 'LegendControllerOptions';
+        }
+        return 'LegendDeveloperOptions';
+    }
+
+    override bool MenuEvent(int mkey, bool fromcontroller)
+    {
+        int tab = TabIndex();
+        int count = TabCount();
+        if (tab >= 0 && tab < count && (mkey == MKEY_PageUp || mkey == MKEY_PageDown))
+        {
+            Name next = TabMenu((tab + (mkey == MKEY_PageUp ? count - 1 : 1)) % count);
+            MenuSound("menu/change");
+            Close();
+            Menu.SetMenu(next);
+            return true;
+        }
+        return Super.MenuEvent(mkey, fromcontroller);
+    }
+}
+
+class OptionMenuItemRenderScaleSlider : OptionMenuItemSlider
+{
+    override int Draw(OptionMenuDescriptor desc, int y, int indent, bool selected)
+    {
+        mLabel = String.format("RENDER %.2f", GetSliderValue() / 10.0);
+        return Super.Draw(desc, y, indent, selected);
+    }
+}
+
+class OptionMenuItemRenderDistanceSlider : OptionMenuItemSlider
+{
+    override void SetSliderValue(double val)
+    {
+        Super.SetSliderValue(int(val + 0.5));
+    }
+
+    override int Draw(OptionMenuDescriptor desc, int y, int indent, bool selected)
+    {
+        static const String levels[] = { "LOW", "NORMAL", "HIGH" };
+        mLabel = "DIST. " .. levels[clamp(int(GetSliderValue()), 0, 2)];
+        return Super.Draw(desc, y, indent, selected);
+    }
+}
+
+class LegendControlsReferenceMenu : LegendSplitOptionMenu
+{
+    override void Drawer()
+    {
+        int y = 8 * CleanYfac_1;
+        int rowHeight = 13 * CleanYfac_1;
+        int inputRight = screen.GetWidth() / 2 - 8 * CleanXfac_1;
+        int actionLeft = screen.GetWidth() / 2 + 8 * CleanXfac_1;
+        static const String inputs[] = {
+            "CIRCLE PAD", "C-STICK / TOUCH", "A", "R", "L", "X", "Y",
+            "DPAD LEFT / RIGHT", "ZL / ZR", "DPAD DOWN", "DPAD UP",
+            "START", "SELECT"
+        };
+        static const String actions[] = {
+            "MOVE / STRAFE", "LOOK", "USE / INTERACT", "ATTACK",
+            "ALT ATTACK", "SPRINT AT FULL LIFE", "JUMP", "CHANGE WEAPON",
+            "CHANGE ITEM", "USE ITEM", "MAP", "PAUSE", "MENU / OVERLAY"
+        };
+
+        for (int row = 0; row < 13; row++)
+        {
+            int inputX = inputRight - Menu.OptionWidth(inputs[row]) * CleanXfac_1;
+            Menu.DrawOptionText(inputX, y, OptionMenuSettings.mFontColor, inputs[row]);
+            Menu.DrawOptionText(actionLeft, y, OptionMenuSettings.mFontColorValue, actions[row]);
+            y += rowHeight;
+        }
+    }
+}
+
+class LegendUpdateMenu : LegendSplitOptionMenu
+{
+    int NativeUpdateConfirm;
+    int NativeUpdateChoice;
+    int NativeUpdatePage;
+    int NativeUpdatePages;
+    int NativeUpdateAll; // CHANGELOG: 0 NEW (since the installed version), 1 ALL versions
+
+    override void Init(Menu parent, OptionMenuDescriptor desc)
+    {
+        Super.Init(parent, desc);
+        NativeUpdatePage = 0;
+        NativeUpdatePages = 1;
+        NativeUpdateChoice = 1;
+        // Opened by the start-up check (AUTO UPDATE): straight to its offer.
+        if (LODUpdateAction(6))
+        {
+            NativeUpdateConfirm = 2;
+            NativeUpdateChoice = 0;
+        }
+        else LODUpdateAction(0);
+    }
+
+    override bool MenuEvent(int mkey, bool fromcontroller)
+    {
+        int state = LODUpdateAction(-1);
+        if (mkey == MKEY_PageUp || mkey == MKEY_PageDown)
+        {
+            NativeUpdatePage = clamp(NativeUpdatePage + (mkey == MKEY_PageUp ? -1 : 1), 0, NativeUpdatePages - 1);
+            return true;
+        }
+        if (state & 256)
+        {
+            if (mkey == MKEY_Back) LODUpdateAction(4);
+            return true;
+        }
+        // 2: the start-up offer, YES / NO (the notes are on the top screen, L R).
+        if (NativeUpdateConfirm == 2)
+        {
+            if (mkey == MKEY_Back) { Close(); return true; }
+            if (mkey == MKEY_Left || mkey == MKEY_Right || mkey == MKEY_Up || mkey == MKEY_Down)
+                NativeUpdateChoice = 1 - NativeUpdateChoice;
+            if (mkey == MKEY_Enter)
+            {
+                if (NativeUpdateChoice == 0) { NativeUpdateConfirm = 0; LODUpdateAction(3); }
+                else Close();
+            }
+            return true;
+        }
+        if (NativeUpdateConfirm)
+        {
+            if (mkey == MKEY_Back) NativeUpdateConfirm = 0;
+            if (mkey == MKEY_Left || mkey == MKEY_Right || mkey == MKEY_Up || mkey == MKEY_Down)
+                NativeUpdateChoice = 1 - NativeUpdateChoice;
+            if (mkey == MKEY_Enter)
+            {
+                NativeUpdateConfirm = 0;
+                if (NativeUpdateChoice == 0) LODUpdateAction(3);
+            }
+            return true;
+        }
+        if (mkey == MKEY_Back) { Close(); return true; }
+        if (mkey == MKEY_Up) mDesc.mSelectedItem = (mDesc.mSelectedItem + 5) % 6;
+        if (mkey == MKEY_Down) mDesc.mSelectedItem = (mDesc.mSelectedItem + 1) % 6;
+        if (mkey == MKEY_Enter || ((mkey == MKEY_Left || mkey == MKEY_Right) &&
+            (mDesc.mSelectedItem <= 1 || mDesc.mSelectedItem == 4)))
+        {
+            switch (mDesc.mSelectedItem)
+            {
+            case 0: LODUpdateAction(5); break;
+            case 1: LODUpdateAction(2); break;
+            case 2: LODUpdateAction(1); break;
+            case 3:
+                if (state == 3) { NativeUpdateConfirm = 1; NativeUpdateChoice = 1; }
+                break;
+            case 4: NativeUpdateAll = 1 - NativeUpdateAll; NativeUpdatePage = 0; break;
+            case 5: Close(); break;
+            }
+        }
+        return true;
+    }
+}
