BasicInfo:
  Title: "Legend of Doom 3DS*"
  ProductCode: "CTR-P-LDOT"
  Logo: Homebrew

RomFs:
  RootPath: $(APP_ROMFS)

TitleInfo:
  Category: Application
  UniqueId: 0x5A2D1

Option:
  UseOnSD: true
  FreeProductCode: true
  MediaFootPadding: false
  EnableCrypt: false
  EnableCompress: true

AccessControlInfo:
  CoreVersion: 2
  DescVersion: 2
  ReleaseKernelMajor: "02"
  ReleaseKernelMinor: "33"
  UseExtSaveData: false
  FileSystemAccess:
    - CategoryFileSystemTool
    - DirectSdmc
    - DirectSdmcWrite
  MemoryType: Application
  # Old 3DS/2DS: 80 MB (Dev2). 96 MB made the 2DS's HOME menu crash on launch (2026-10-14).
  SystemMode: 80MB
  IdealProcessor: 0
  AffinityMask: 1
  Priority: 16
  # Core 1 time: bit 7 the scheduling mode, the rest the most the game may ask for with
  # APT_SetAppCpuTimeLimit. 0x9E capped it at 30%, so the Old 3DS's 80% for the music (#16)
  # was refused (0xD8E05BF4, 2026-10-18).
  MaxCpu: 0xD0
  HandleTableSize: 0x200
  DisableDebug: false
  EnableForceDebug: false
  CanWriteSharedPage: true
  CanUsePrivilegedPriority: false
  CanUseNonAlphabetAndNumber: true
  PermitMainFunctionArgument: true
  CanShareDeviceMemory: true
  RunnableOnSleep: false
  SpecialMemoryArrange: true
  # New 3DS: the full 124 MB arena. Its 804 MHz and L2 cache are turned on at run time
  # (osSetSpeedupEnable, through ptm:sysm), not here: with CpuSpeed / EnableL2Cache /
  # CanAccessCore2 in the exheader the 2DS started the game in 64 MB (2026-10-14).
  SystemModeExt: 124MB
  CpuSpeed: 268MHz
  EnableL2Cache: false
  CanAccessCore2: false
  IORegisterMapping:
    - 1ff00000-1ff7ffff
  MemoryMapping:
    - 1f000000-1f5fffff:r
  SystemCallAccess:
    ControlMemory: 1
    QueryMemory: 2
    ExitProcess: 3
    CreateThread: 8
    ExitThread: 9
    SleepThread: 10
    GetThreadPriority: 11
    SetThreadPriority: 12
    CreateMutex: 19
    ReleaseMutex: 20
    CreateSemaphore: 21
    ReleaseSemaphore: 22
    CreateEvent: 23
    SignalEvent: 24
    ClearEvent: 25
    CreateTimer: 26
    SetTimer: 27
    CancelTimer: 28
    ClearTimer: 29
    CreateMemoryBlock: 30
    MapMemoryBlock: 31
    UnmapMemoryBlock: 32
    CreateAddressArbiter: 33
    ArbitrateAddress: 34
    CloseHandle: 35
    WaitSynchronization1: 36
    WaitSynchronizationN: 37
    DuplicateHandle: 39
    GetSystemTick: 40
    GetHandleInfo: 41
    GetSystemInfo: 42
    GetProcessInfo: 43
    GetThreadInfo: 44
    ConnectToPort: 45
    SendSyncRequest1: 46
    SendSyncRequest2: 47
    SendSyncRequest3: 48
    SendSyncRequest4: 49
    SendSyncRequest: 50
    GetThreadId: 55
    GetResourceLimit: 56
    GetResourceLimitLimitValues: 57
    GetResourceLimitCurrentValues: 58
    Break: 60
    OutputDebugString: 61
    StoreProcessDataCache: 83
    FlushProcessDataCache: 84
  ServiceAccessControl:
    - ac:u
    - soc:U
    - ssl:C
    - am:net
    - APT:U
    - cfg:u
    - dsp::DSP
    - fs:USER
    - gsp::Gpu
    - hid:USER
    - ptm:u
    - ptm:sysm

SystemControlInfo:
  SaveDataSize: 0KB
  RemasterVersion: 1
  StackSize: 0x80000
  Dependency:
    ac: 0x0004013000002402
    am: 0x0004013000001502
    socket: 0x0004013000002e02
    ssl: 0x0004013000002f02
    cfg: 0x0004013000001702
    dsp: 0x0004013000001a02
    gsp: 0x0004013000001c02
    hid: 0x0004013000001d02
    ptm: 0x0004013000002202
